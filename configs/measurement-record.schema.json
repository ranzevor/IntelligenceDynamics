{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IntelligenceDynamics measurement protocol 0.1",
  "oneOf": [
    {
      "$ref": "#/$defs/RunMetadata"
    },
    {
      "$ref": "#/$defs/StepRecord"
    },
    {
      "$ref": "#/$defs/AdaptationEvent"
    },
    {
      "$ref": "#/$defs/InterventionRecord"
    }
  ],
  "$defs": {
    "RunMetadata": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "track": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "A",
            "B",
            "C",
            "AB",
            "cross"
          ]
        },
        "system_name": {
          "type": "string",
          "minLength": 1
        },
        "environment_name": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer"
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "config_digest": {
          "type": "string",
          "minLength": 1
        },
        "protocol_version": {
          "type": "string",
          "minLength": 1,
          "const": "0.1"
        },
        "upstream_revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "environment_revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "exploratory": {
          "type": "boolean"
        },
        "notes": {
          "type": "object",
          "additionalProperties": {}
        },
        "record_type": {
          "const": "RunMetadata"
        }
      },
      "required": [
        "config_digest",
        "environment_name",
        "protocol_version",
        "record_type",
        "run_id",
        "seed",
        "source_revision",
        "system_name",
        "track"
      ],
      "additionalProperties": false
    },
    "StepRecord": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "step": {
          "type": "integer",
          "minimum": 0
        },
        "lifetime": {
          "type": "number",
          "minimum": 0
        },
        "capability": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "reward_or_return": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "loss": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "computation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComputationCounters"
            },
            {
              "type": "null"
            }
          ]
        },
        "memory": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemoryAccounting"
            },
            {
              "type": "null"
            }
          ]
        },
        "routing": {
          "anyOf": [
            {
              "$ref": "#/$defs/RoutingSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "state_norm": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "prediction_error": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "salience": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "uncertainty": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "plasticity_probe_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "context_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "extras": {
          "type": "object",
          "additionalProperties": {}
        },
        "protocol_version": {
          "type": "string",
          "minLength": 1,
          "const": "0.1"
        },
        "record_type": {
          "const": "StepRecord"
        }
      },
      "required": [
        "lifetime",
        "protocol_version",
        "record_type",
        "run_id",
        "step"
      ],
      "additionalProperties": false
    },
    "AdaptationEvent": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "step": {
          "type": "integer",
          "minimum": 0
        },
        "event_type": {
          "type": "string",
          "minLength": 1
        },
        "hidden_from_agent": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "target_recovery_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tags": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "protocol_version": {
          "type": "string",
          "minLength": 1,
          "const": "0.1"
        },
        "record_type": {
          "const": "AdaptationEvent"
        }
      },
      "required": [
        "description",
        "event_id",
        "event_type",
        "hidden_from_agent",
        "protocol_version",
        "record_type",
        "step"
      ],
      "additionalProperties": false
    },
    "InterventionRecord": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "intervention_id": {
          "type": "string",
          "minLength": 1
        },
        "mechanism": {
          "type": "string",
          "minLength": 1
        },
        "intervention_type": {
          "type": "string",
          "minLength": 1
        },
        "start_step": {
          "type": "integer",
          "minimum": 0
        },
        "end_step": {
          "type": "integer",
          "minimum": 0
        },
        "delta_capability": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "delta_adaptation_metric": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "delta_compute_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "delta_plasticity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "recovery_steps": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "matched_compute_budget": {
          "type": "boolean"
        },
        "details": {
          "type": "object",
          "additionalProperties": {}
        },
        "protocol_version": {
          "type": "string",
          "minLength": 1,
          "const": "0.1"
        },
        "record_type": {
          "const": "InterventionRecord"
        }
      },
      "required": [
        "end_step",
        "intervention_id",
        "intervention_type",
        "mechanism",
        "protocol_version",
        "record_type",
        "run_id",
        "start_step"
      ],
      "additionalProperties": false
    },
    "ComputationCounters": {
      "type": "object",
      "properties": {
        "active_unit_updates": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "potential_unit_updates": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "active_edge_events": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "potential_edge_events": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "matrix_multiply_ops": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "spike_or_event_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "recurrent_iterations": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "state_transitions": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "routing_decisions": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "learning_updates": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "wall_time_seconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "MemoryAccounting": {
      "type": "object",
      "properties": {
        "persistent_state_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "parameter_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "replay_or_episodic_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "external_memory_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "read_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "write_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "retained_history_steps": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "RoutingSummary": {
      "type": "object",
      "properties": {
        "active_modules": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "available_modules": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "active_units": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "available_units": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "active_edges": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "available_edges": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "reused_units": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "newly_allocated_units": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "routing_entropy": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "route_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    }
  }
}
